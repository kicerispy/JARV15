# JARVIS local configuration
# Copy this file to .env and change only what you need.

# -------------------------
# Ollama / models
# -------------------------
OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_CHAT_MODEL=qwen3.5:9b
JARVIS_PLANNER_MODEL=qwen3.5:9b
JARVIS_CHANGE_PLANNER_MODEL=qwen3.5:9b
JARVIS_CODING_MODEL=qwen2.5-coder:14b
JARVIS_CODING_FALLBACK_MODEL=gemma4:26b
JARVIS_VISION_MODEL=qwen2.5vl:3b
JARVIS_VERIFY_MODEL=gemma4:e2b

# -------------------------
# Audio / voice
# -------------------------
# Device IDs are machine-specific. Leave the defaults alone until you
# identify your own microphone/output device indexes.
JARVIS_MIC_DEVICE=1
JARVIS_OUTPUT_DEVICE=5
JARVIS_WHISPER_MODEL=small.en
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8

# -------------------------
# Weather
# -------------------------
JARVIS_DEFAULT_WEATHER_LOCATION=Belvidere, IL

# -------------------------
# Planner / generation
# -------------------------
JARVIS_OLLAMA_GENERATION_MAX_ATTEMPTS=2
JARVIS_OLLAMA_GENERATION_RETRY_DELAY=0.35
JARVIS_PLANNER_NUM_PREDICT=512
JARVIS_CHANGE_PLANNER_NUM_PREDICT=512
JARVIS_PRODUCT_RESEARCH_NUM_PREDICT=900
JARVIS_PLANNER_MODEL_KEEP_ALIVE=10m
JARVIS_CODING_MODEL_KEEP_ALIVE=15m
JARVIS_PRELOAD_CODING_MODEL=1
JARVIS_CODING_MODEL_WARMUP_DELAY_SECONDS=15
JARVIS_CHAT_THINK=false

# -------------------------
# Browser
# -------------------------
JARVIS_CDP_PORT=9222

# -------------------------
# Roblox Studio MCP
# -------------------------
JARVIS_ROBLOX_MCP_URL=http://127.0.0.1:58741
JARVIS_ROBLOX_MCP_DISCOVERY_TTL=60
JARVIS_ROBLOX_MCP_TIMEOUT=60

# -------------------------
# Unreal Engine MCP
# -------------------------
# Native MCP endpoint exposed by Unreal_mcp's MCP Automation Bridge plugin.
JARVIS_UNREAL_MCP_URL=http://127.0.0.1:3000/mcp
# Set this to your Unreal .uproject path to let JARVIS discover
# Saved/MCP/capability-token automatically.
JARVIS_UNREAL_MCP_PROJECT_PATH=
# Or provide the token directly / via a separate file.
JARVIS_UNREAL_MCP_TOKEN=
JARVIS_UNREAL_MCP_TOKEN_FILE=
JARVIS_UNREAL_MCP_TIMEOUT=120
JARVIS_UNREAL_MCP_EXTERNAL_DIR=

# -------------------------
# External context / memory
# -------------------------
# auto = OpenViking -> agentmemory -> legacy SQLite fallback.
JARVIS_CONTEXT_MEMORY_BACKEND=auto
JARVIS_EXTERNAL_TASK_MEMORY=1
JARVIS_AGENTMEMORY_URL=http://127.0.0.1:3111
JARVIS_AGENTMEMORY_SECRET=
JARVIS_OPENVIKING_URL=http://127.0.0.1:1933
JARVIS_OPENVIKING_API_KEY=
JARVIS_OPENVIKING_ACCOUNT=
JARVIS_OPENVIKING_USER=

# Optional Hindsight memory backend. Set JARVIS_ADAPTIVE_MEMORY_ENABLED=1
# and run a local Hindsight server on the configured URL.
JARVIS_HINDSIGHT_URL=http://127.0.0.1:8888
JARVIS_HINDSIGHT_BANK_ID=jarvis
JARVIS_HINDSIGHT_API_KEY=
JARVIS_HINDSIGHT_TIMEOUT=8
JARVIS_ADAPTIVE_MEMORY_ENABLED=0

# -------------------------
# Agent Skills
# -------------------------
# External repositories are cloned only by the explicit "sync agent skills" command.
JARVIS_AGENT_SKILLS_DIR=
JARVIS_AGENT_SKILL_SOURCES_FILE=
JARVIS_AGENT_SKILL_SYNC_DEPTH=1

# -------------------------
# n8n
# -------------------------
JARVIS_N8N_ENABLED=0
JARVIS_N8N_BASE_URL=http://127.0.0.1:5678
JARVIS_N8N_WEBHOOK_PATH=webhook/jarvis-gateway
JARVIS_N8N_WEBHOOK_TOKEN=
JARVIS_N8N_TIMEOUT_SECONDS=15
JARVIS_N8N_LOCAL_ACTION_PORT=8765
JARVIS_N8N_AUTOSTART=1

# Optional direct n8n instance-level MCP workflow tools.
JARVIS_N8N_MCP_URL=http://127.0.0.1:5678/mcp-server/http
JARVIS_N8N_MCP_TOKEN=
JARVIS_N8N_MCP_TOKEN_FILE=
JARVIS_N8N_MCP_ENABLED=0
JARVIS_N8N_MCP_TIMEOUT_SECONDS=20
JARVIS_N8N_MCP_DISCOVERY_TTL_SECONDS=30
JARVIS_N8N_MCP_EXECUTION_TIMEOUT_SECONDS=60
JARVIS_N8N_MCP_MAX_RESPONSE_BYTES=2097152

# -------------------------
# Runtime
# -------------------------
JARVIS_TYPED_INPUT=1
JARVIS_DEBUG=false

# Bounded self-healing / resilience.
JARVIS_SELF_HEALING_ENABLED=1
JARVIS_SELF_HEALING_MAX_ATTEMPTS=2
JARVIS_SELF_HEALING_FAILURE_MEMORY_ENABLED=1
JARVIS_SELF_HEALING_RETRY_BACKOFF_BASE_SECONDS=0.25
JARVIS_SELF_HEALING_RETRY_BACKOFF_MAX_SECONDS=4
JARVIS_TOOL_RESILIENCE_ENABLED=1
JARVIS_TOOL_CIRCUIT_BREAKER_ENABLED=1
JARVIS_TOOL_CIRCUIT_FAILURE_THRESHOLD=4
JARVIS_TOOL_CIRCUIT_COOLDOWN_SECONDS=20

# Learned strategy reuse is conservative: repeated verified successes only.
JARVIS_AUTONOMY_LEARNED_STRATEGY_ENABLED=1
JARVIS_AUTONOMY_AUTO_VERIFICATION_ENABLED=1
JARVIS_AUTONOMY_STRATEGY_MIN_SUCCESSES=3
JARVIS_AUTONOMY_STRATEGY_MIN_SUCCESS_RATE=0.75
JARVIS_AUTONOMY_STRATEGY_QUARANTINE_SECONDS=3600

# Concise action-first narration policy.
JARVIS_RESPONSE_STYLE=action_first
